# FILE: apps/api/.env.example
# Copy this file to apps/api/.env and fill in YOUR values. Never commit .env.
# What every variable means, and which are secret: docs/secrets.md

# IMPORTANT: the user must be rahisisha_user, NEVER postgres. A superuser
# ignores the row-level locks that keep shops apart (docs/RUNBOOK.md, incident 2).
DATABASE_URL=postgresql://rahisisha_user:YOUR_APP_PASSWORD@localhost:5432/rahisisha
JWT_SECRET=some-long-random-string-change-this
NODE_ENV=development

# The website addresses the API accepts calls from. Without this line the
# browser is refused and the signup page says "We couldn't reach the server".
# Locally it is the web app's address.
WEB_ORIGIN=http://localhost:3001

# 32 random bytes, base64 (44 characters). Encrypts per-shop WhatsApp tokens.
# Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit a real key. If it is lost, stored tokens cannot be read again.
KMS_KEY=put-your-own-44-character-key-here

# Daraja (M-Pesa) SANDBOX keys, used only by scripts/seed-daraja-demo.js. Never commit real values.
# DARAJA_SANDBOX_CONSUMER_KEY=put-your-sandbox-consumer-key-here
# DARAJA_SANDBOX_CONSUMER_SECRET=put-your-sandbox-consumer-secret-here
# DARAJA_SANDBOX_PASSKEY=put-your-sandbox-passkey-here
# DARAJA_SANDBOX_SHORTCODE=174379
# DARAJA_CALLBACK_BASE=https://your-public-address.example

# Only when running online (leave unset on a laptop). See docs/secrets.md.
# ROOT_DOMAIN=example.com
# COOKIE_DOMAIN=.example.com

PORT=3000