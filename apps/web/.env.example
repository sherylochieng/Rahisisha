# FILE: apps/web/.env.example
# Copy this file to apps/web/.env.local. Never commit .env.local.
# The address of the API. It MUST end in /v1: the web app adds only the end of
# the address (for example /signup). Without /v1 the signup page says "Route not found".
# Locally:  http://localhost:3000/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/v1